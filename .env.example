DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Documentation
API_TITLE=Matching API
API_VERSION=1.0.0
API_DESCRIPTION=Headless matching system with automated documentation
