# syntax=docker/dockerfile:1

# ---- Deps: node_modules once, shared by dev/build stages ----
# tsc -b (part of `npm run build`) needs the devDependencies too, so there's
# no separate lean "prod deps" stage like the backend has — the final
# runtime image below has no node_modules in it at all anyway.
FROM node:22-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# ---- Dev: live-reload dev server (docker-compose.yml bind-mounts the source
# over this, so the COPY here only matters for a standalone `docker run`) ----
FROM deps AS dev
COPY frontend/ /app/
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# ---- Builder: production static build ----
# VITE_API_BASE_URL is inlined into the JS bundle at build time (Vite env
# vars are not runtime-configurable, unlike the backend's Django settings),
# so it has to arrive as a build ARG rather than a container environment
# variable — changing it means rebuilding this image.
FROM deps AS builder
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
COPY frontend/ /app/
RUN npm run build

# ---- Runtime: nginx serving the static build (default target) ----
FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
