# 백엔드 API 베이스 URL (Django, 기본 개발 포트 8000)
VITE_API_BASE_URL=http://localhost:8000

# 카카오 로그인 REST API 키 (Kakao Developers 콘솔 > 앱 키 > REST API 키).
# client_secret이 아니라 프론트 번들에 노출돼도 되는 값. 비워두면
# 회원가입 화면이 "성인인증 기능이 아직 설정되지 않았습니다" 안내만 보여줌.
VITE_KAKAO_CLIENT_ID=
# 카카오 콘솔에 등록한 Redirect URI와 정확히 일치해야 함.
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback